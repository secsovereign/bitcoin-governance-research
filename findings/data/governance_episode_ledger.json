      "episode_id": "blocksize-2015",
      "proposal": "Block size increase / blocksize wars",
      "venue": "bitcoin-dev",
      "technical_objections": [
        {
          "text": "having miners -- or any group -- vote on block size is not an intrinsically good thing.",
          "source": "mail",
          "answered": "",
          "basis": "",
          "cite": "7bb2fa3257fb3233839f824429337941611e2820340a7eaf6ae5f9dac04a6217"
        },
        {
          "text": "The trouble is this requires maintaining a hash tree commitment over validator state, which turns out to be insanely expensive. \u2026 if you also want this commitment scheme for fraud proofs, then you should be arguing for a block size limit decrease (to 500kB), not increase.",
          "source": "mail",
          "answered": "",
          "basis": "",
          "cite": "6f6f7d58549247ea96a42ed22c5156367d6590ee67f0aa028639caada3f2f9bd"
        }
      ],
      "process_objections": [],
      "outcome": "",
      "corpus_cites": [
